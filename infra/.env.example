# ========================================
# TeamElGhazi OS — Variables d'environnement
# Copiez ce fichier en .env et ajustez les valeurs
# NE JAMAIS COMMITTER LE FICHIER .env
# ========================================

# Application
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Base de données PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=teamelghazi_os
POSTGRES_USER=teos
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://teos:changeme@localhost:5432/teamelghazi_os

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# MinIO (Stockage objet)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123
MINIO_BUCKET_DOCUMENTS=teos-documents
MINIO_USE_SSL=false

# Auth / JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# MFA (TOTP)
MFA_ISSUER=TeamElGhazi OS

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
SMTP_FROM="TeamElGhazi OS <noreply@example.com>"

# WhatsApp Business API (simulé en dev)
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_TOKEN=CHANGE_ME

# SMS (simulé en dev)
SMS_API_URL=https://api.sms.example.com
SMS_API_TOKEN=CHANGE_ME

# IA / OpenAI compatible
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=gpt-4o

# Paiement (simulé en dev - NE PAS INTÉGRER DE VRAIE CLÉ)
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Logs
LOG_LEVEL=debug
